# Meta / Instagram credentials
META_VERIFY_TOKEN=change-this-to-a-random-secret
META_APP_SECRET=your_meta_app_secret
IG_ACCESS_TOKEN=your_instagram_access_token
META_API_VERSION=v26.0

# Automation
COMMENT_KEYWORD=کانفیگ
